# Optional: connect the contact form to Formspree. Without this, it opens a pre-filled email to BPRx.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Optional: add a Calendly or Microsoft Bookings link.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/YOUR_ACCOUNT

# Required for the restricted Formulary Reference (Clerk Vercel Marketplace).
# Pull actual environment-specific keys with `vercel env pull`; never commit them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Optional bootstrap allowlist: comma-separated verified email addresses.
# Other users require server-managed Clerk publicMetadata.formularyAccess=true.
FORMULARY_APPROVED_EMAILS=

# Protected Users & Access owners who can assign/remove administrator roles.
# A verified primary email is required; delegated admins use private metadata.
# Separate from ordinary reference approval; never use a NEXT_PUBLIC variable.
FORMULARY_ADMIN_EMAILS=
